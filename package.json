{
  "name": "uwu-speak",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "UwUSpeak: a Vencord plugin that converts your Discord messages to UwU or nya speak.",
  "license": "MIT",
  "author": "MagicCat3022",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MagicCat3022/UwU_Speak.git"
  },
  "homepage": "https://github.com/MagicCat3022/UwU_Speak#readme",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/core.test.ts tests/installer.test.mjs",
    "check": "npm run typecheck && npm test",
    "web": "vite --config web/vite.config.ts",
    "web:build": "vite build --config web/vite.config.ts",
    "web:preview": "vite preview --config web/vite.config.ts",
    "test:browser": "playwright test --config web/playwright.config.ts",
    "test:all": "npm run check && npm run test:browser",
    "format": "prettier --write src tests scripts install/installer.mjs web package.json tsconfig.json .prettierrc.json",
    "benchmark": "tsx scripts/benchmark.ts",
    "vencord:build": "node scripts/build-vencord.mjs",
    "vencord:install": "node scripts/build-vencord.mjs --install ../Vencord",
    "eval:intent": "tsx scripts/compare-intent.ts"
  },
  "dependencies": {
    "unicode-segmenter": "0.17.3"
  },
  "devDependencies": {
    "@huggingface/transformers": "^4.3.0",
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.2",
    "esbuild": "0.28.2",
    "prettier": "3.9.8",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  }
}
